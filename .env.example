# ==============================================================================
# Quantum Disaster Resource Optimizer (QDO) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit real credentials to version control.
#
# 1. Sign up or log in at: https://console.twilio.com
# 2. Retrieve your Account SID and Auth Token from the Twilio Console Dashboard.
# 3. For Programmable Messaging:
#    - Get your Twilio phone number from Phone Numbers -> Manage -> Active numbers
#    - Set TWILIO_PHONE_NUMBER to your Twilio sender number (E.164, e.g. +14155550100)
# 4. Set QDO_ADMIN_PHONE_NUMBERS to your authorized admin mobile number(s)
#    (comma-separated if multiple, e.g. +14155552671, +14155559999)
# ==============================================================================

# Twilio Account Credentials
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_rotated_auth_token

# Twilio Programmable Messaging Sender Phone Number (E.164 format)
TWILIO_PHONE_NUMBER=your_twilio_sender_number

# Authorized Administrator Mobile Numbers (only these numbers can request/verify login OTPs)
QDO_ADMIN_PHONE_NUMBERS=your_authorized_admin_number

# Optional: Twilio Verify Service SID (if using Twilio Verify instead of Programmable Messaging)
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_optional

# Security Configuration
QDO_SESSION_TIMEOUT_SECONDS=3600
QDO_OTP_RESEND_COOLDOWN_SECONDS=60
